library(ellmer); library(ragnar)
store <- ragnar_store_connect("papers.duckdb", read_only = TRUE)
library(ragnar)
lib_dir <- r"(C:\Users\Aleksander\Desktop\Coding\R\ai_blog\RAG\Library)"
db_path <- file.path(lib_dir, "papers.duckdb")
store <- ragnar_store_create(
db_path,
embed = \(x) embed_google_gemini(x, model = "gemini-embedding-001"),
overwrite = TRUE
)
files <- list.files(file.path(lib_dir, "papers"), pattern = "\\.pdf$",
full.names = TRUE, ignore.case = TRUE)
failed <- character()
for (file in files) {
message("Ingesting: ", basename(file))
tryCatch({
chunks <- file |> read_as_markdown() |> markdown_chunk()
ragnar_store_insert(store, chunks)
}, error = function(e) {
message("  Failed: ", conditionMessage(e))
failed <<- c(failed, file)
})
Sys.sleep(1)  # be gentle with free-tier rate limits
}
ragnar_store_build_index(store)
if (length(failed)) message("Skipped ", length(failed), " file(s):\n", paste(basename(failed), collapse = "\n"))
DBI::dbDisconnect(store@con, shutdown = TRUE)
library(ellmer); library(ragnar)
db_path <- r"(C:\Users\Aleksander\Desktop\Coding\R\ai_blog\RAG\Library\papers.duckdb)"
store <- ragnar_store_connect(db_path, read_only = TRUE)
chat <- chat_google_gemini(   # or chat_anthropic() if you have a key
system_prompt = "
You answer questions about the user's research papers.
Always search the store before answering. Cite the source file
for every claim. If the papers don't contain the answer, say so."
)
ragnar_register_tool_retrieve(chat, store, top_k = 10)
chat$chat("What was the research question(s) posed by the Heltne paper?")
